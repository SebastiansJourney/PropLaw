# Copy to .env and fill in. Never commit .env.

# Required: backend LLM calls (propra/api, propra/retrieval)
ANTHROPIC_API_KEY=your_key_here

# Optional: CORS origin of the frontend (propra/main.py). Default: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Optional: LLM judge for benchmark runs (propra/benchmark/judge_runner.py)
OPENAI_API_KEY=

# Optional: node inventory drafting (propra/data/draft_inventory.py)
# GOOGLE_API_KEY is accepted as a fallback for GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
